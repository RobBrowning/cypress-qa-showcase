{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "node16",
    "moduleResolution": "node16",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["cypress", "node", "cypress-axe"]
  },
  "include": ["cypress/**/*.ts", "src/**/*.ts", "types/**/*.d.ts", "cypress.config.ts"]
}
